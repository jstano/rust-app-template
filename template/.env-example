# Copy to .env and fill in real values. Never commit .env.

PORT=8080
IS_DEV=true

# ES256 (P-256) keypair for JWT signing. Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out private.pem
#   openssl ec -in private.pem -pubout -out public.pem
# If unset, the app falls back to a hardcoded demo keypair — fine for local `cargo run`,
# never for anything deployed.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

{{ project_name | upper | replace('-', '_') }}_DATABASE_URL=postgres://{{ db_username }}:{{ db_password }}@localhost:5432/{{ db_name }}
